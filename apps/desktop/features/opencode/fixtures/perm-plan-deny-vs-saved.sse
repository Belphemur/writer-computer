their status and next run, and the current time.\",\n      \"signature\": \"tools.automation.list(): Promise<{\\n  /** The current time, in UTC. */\\n  now: string,\\n  automations: Array<{\\n      /** \u0040pattern ^aut_ */\\n      id: string,\\n      name: string,\\n      trigger: {\\n          type: \\\"at\\\",\\n          /** An instant with an offset, a wall-clock time in tz such as \\\"2026-10-27T09:00\\\", or \\\"in 10 minutes\\\". */\\n          at: string,\\n          tz?: string,\\n        } | {\\n          type: \\\"every\\\",\\n          /** A duration such as \\\"90 seconds\\\", \\\"5 minutes\\\" or \\\"2 hours\\\". */\\n          every: string,\\n          tz?: string,\\n        } | {\\n          type: \\\"cron\\\",\\n          cron: string,\\n          tz?: string,\\n        } | {\\n          type: \\\"event\\\",\\n          /** \u0040minLength 1 */\\n          server: string,\\n          /** \u0040minLength 1 */\\n          event: string,\\n          args?: {},\\n        },\\n      tz: string,\\n      status: \\\"active\\\" | \\\"paused\\\" | \\\"done\\\",\\n      nextDueAt?: string,\\n      expires?: string,\\n      runCount: number,\\n      lastRunAt?: string,\\n      lastOutcome?: \\\"fired\\\" | \\\"late\\\" | \\\"skipped\\\" | \\\"disabled\\\" | \\\"failed\\\" | \\\"expired\\\",\\n      action: {\\n          type: \\\"prompt\\\",\\n          prompt: string,\\n          to: {\\n              /** \u0040pattern ^ses */\\n              session: string,\\n              subagent?: unknown,\\n            } | {\\n              subagent: string,\\n              session?: unknown,\\n            },\\n        } | {\\n          type: \\\"code\\\",\\n          code: string,\\n          args?: unknown,\\n        } | {\\n          type: \\\"shell\\\",\\n          /** \u0040minLength 1 */\\n          command: string,\\n        },\\n      lastOutput?: string,\\n      state?: unknown,\\n    }>,\\n}>\"\n    },\n    {\n      \"path\": \"tools.automation.pause\",\n  