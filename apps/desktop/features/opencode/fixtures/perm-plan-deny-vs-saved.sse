cursor.\",\n      \"signature\": \"tools.automation.resume({\\n  /** Automation id from automation.list. \u0040pattern ^aut_ */\\n  id: string,\\n}): Promise<{\\n  /** \u0040pattern ^aut_ */\\n  id: string,\\n  name: string,\\n  trigger: {\\n      type: \\\"at\\\",\\n      /** An instant with an offset, a wall-clock time in tz such as \\\"2026-10-27T09:00\\\", or \\\"in 10 minutes\\\". */\\n      at: string,\\n      tz?: string,\\n    } | {\\n      type: \\\"every\\\",\\n      /** A duration such as \\\"90 seconds\\\", \\\"5 minutes\\\" or \\\"2 hours\\\". */\\n      every: string,\\n      tz?: string,\\n    } | {\\n      type: \\\"cron\\\",\\n      cron: string,\\n      tz?: string,\\n    } | {\\n      type: \\\"event\\\",\\n      /** \u0040minLength 1 */\\n      server: string,\\n      /** \u0040minLength 1 */\\n      event: string,\\n      args?: {},\\n    },\\n  tz: string,\\n  status: \\\"active\\\" | \\\"paused\\\" | \\\"done\\\",\\n  nextDueAt?: string,\\n  expires?: string,\\n  runCount: number,\\n  lastRunAt?: string,\\n  lastOutcome?: \\\"fired\\\" | \\\"late\\\" | \\\"skipped\\\" | \\\"disabled\\\" | \\\"failed\\\" | \\\"expired\\\",\\n  action: {\\n      type: \\\"prompt\\\",\\n      prompt: string,\\n      to: {\\n          /** \u0040pattern ^ses */\\n          session: string,\\n          subagent?: unknown,\\n        } | {\\n          subagent: string,\\n          session?: unknown,\\n        },\\n    } | {\\n      type: \\\"code\\\",\\n      code: string,\\n      args?: unknown,\\n    } | {\\n      type: \\\"shell\\\",\\n      /** \u0040minLength 1 */\\n      command: string,\\n    },\\n  lastOutput?: string,\\n  state?: unknown,\\n}>\"\n    },\n    {\n      \"path\": \"tools.opencode.list_mcp_events\",\n      \"description\": \"List the events an MCP server sends. Use one as an automation's event trigger.\",\n      \"signature\": \"tools.opencode.list_mcp_events({\\n  /** MCP server name as configured */\\n  server: string,\\n}): Promise<{\\n  events: Array<{\\n      server: string,\\n      event: string,\\n      description?: string | null,\\n      args?: {} | null,\\n      data?: {} | null,\\n    }>,\\n}>\"\n    },\n    {\n      \"path\": \"tools.opencode.list_mcp_resources\",\n      \"description\": \"List documents, records, and other data exposed by MCP servers. Use this when the user refers to something that is not a local file, such as a URI with a custom scheme, then load a match with read_mcp_resource. Each entry names the server to read it from. Templates are resources addressed by a parameter such as a record ID; fill in the uriTemplate placeholders before reading.\",\n      \"signature\": \"tools.opencode.list_mcp_resources({\\n  /** MCP server name as configured. Omit to list every server. */\\n  server?: string,\\n}): Promise<{\\n  resources: Array<{\\n      server: string,\\n      name: string,\\n      uri: string,\\n      description?: string,\\n      mimeType?: string,\\n    }>,\\n  templates: Array<{\\n      server: string,\\n      name: string,\\n      uriTemplate: string,\\n      description?: string,\\n      mimeType?: string,\\n    }>,\\n}>\"\n    },\n    {\n      \"path\": \"tools.opencode.models\",\n      \"description\": \"Search the models available to use. Use this to turn a model name the user mentions into an exact reference for a tool that takes a model. Check your own provider first. Prefer the standard offering unless the user explicitly requests another tier. Use the listed pricing to compare costs when available; missing pricing does not mean free.\",\n      \"signature\": \"tools.opencode.models({\\n  /** Text to search for in model names and IDs. */\\n  query?: string,\\n  /** Provider ID or name to filter by. Try your own provider first. */\\n  provider?: string,\\n  /**\\n   * Which kind of model to list. Defaults to \\\"chat\\\".\\n   * \\\"chat\\\": a language model (LLM). Powers sessions, agents and subagents, and can call tools.\\n   * \\\"image\\\": generates or edits images from a prompt. It can't chat or call tools.\\n   * \\\"video\\\": generates videos from a prompt. It can't chat or call tools.\\n   */\\n  type?: \\\"chat\\\" | \\\"image\\\" | \\\"video\\\",\\n  /** Include older versions of each model family. By default only the newest version is listed. */\\n  all?: boolean,\\n  /** Maximum number of models to return. Defaults to 20. \u0040integer \u0040minimum 1 \u0040maximum 100 */\\n  limit?: number,\\n  /** Number of models to skip, for paging through results. \u0040integer \u0040minimum 0 */\\n  offset?: number,\\n}): Promise<{\\n  /** Number of matching models across all pages. \u0040integer */\\n  total: number,\\n  /** Offset of the next page, or null on the last page. */\\n  next: number | null,\\n  /** Matching models grouped by provider. Your own provider comes first. */\\n  providers: Array<{\\n      id: string,\\n      name: string,\\n      /** Newest first. */\\n      models: Array<{\\n          /** providerID/modelID */\\n          id: string,\\n          name: string,\\n          /** Release date as a Unix timestamp in milliseconds, or 0 when unknown. */\\n          released: number,\\n          variants: Array<string>,\\n          /** Pricing in USD per million tokens. */\\n          cost: Array<{\\n              tier?: {\\n                type: \\\"context\\\",\\n                /** \u0040integer */\\n                size: number,\\n              },\\n              input: number,\\n              output: number,\\n              cache: {\\n                read: number,\\n                write: number,\\n              },\\n            }>,\\n          status: \\\"alpha\\\" | \\\"beta\\\" | \\\"deprecated\\\" | \\\"active\\\",\\n        }>,\\n    }>,\\n}>\"\n    },\n    {\n      \"path\": \"tools.opencode.read_mcp_resource\",\n      \"description\": \"Read one MCP resource by server and URI. Not for local files. Always return the full contents rather than slicing or filtering them; oversized output is truncated automatically and the full content is saved to a file you can read. Images and PDFs are shown to you directly.\",\n      \"signature\": \"tools.opencode.read_mcp_resource({\\n  /** The server field of the discovered resource. */\\n  server: string,\\n  /** Exact resource URI from discovery, an expanded uriTemplate, or the user. */\\n  uri: string,\\n}): Promise<{\\n  server: string,\\n  uri: string,\\n  contents: Array<{\\n        type: \\\"text\\\",\\n        uri: string,\\n        text: string,\\n        mimeType?: string,\\n      } | {\\n        type: \\\"blob\\\",\\n        uri: string,\\n        blob: string,\\n        mimeType?: string,\\n      }>,\\n}>\"\n    },\n    {\n      \"path\": \"tools.opencode.session.move\",\n      \"description\": \"Move a session to another directory, or omit sessionID to move the current session. The current session moves at the next safe boundary; do not run destination-dependent tools in the same execute call.\",\n      \"signature\": \"tools.opencode.session.move({\\n  /** Omit to move the current session. \u0040pattern ^ses */\\n  sessionID?: string,\\n  /** Destination directory, relative to the target session's directory or absolute. Supports ~. \u0040minLength 1 */\\n  directory: string,\\n}): Promise<{\\n  /** \u0040pattern ^ses */\\n  sessionID: string,\\n  directory: string,\\n}>\"\n    }\n  ],\n  \"remaining\": 3,\n  \"next\": {\n    \"offset\": 10\n  }\n}"}],"metadata":{"toolCalls":[{"tool":"search","status":"completed","input":{"query":""}}],"truncated":false},"executed":false},"durable":{"aggregateID":"ses_fake0002","seq":75,"version":2}}

