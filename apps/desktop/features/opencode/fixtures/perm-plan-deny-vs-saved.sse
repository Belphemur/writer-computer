ng,\\n      description?: string,\\n      mimeType?: string,\\n    }>,\\n}>\"}],\"remaining\":0,\"next\":null}\n\nLogs:\n{\n  \"items\": [\n    {\n      \"path\": \"tools.opencode.read_mcp_resource\",\n      \"description\": \"Read one MCP resource by server and URI. Not for local files. Always return the full contents rather than slicing or filtering them; oversized output is truncated automatically and the full content is saved to a file you can read. Images and PDFs are shown to you directly.\",\n      \"signature\": \"tools.opencode.read_mcp_resource({\\n  /** The server field of the discovered resource. */\\n  server: string,\\n  /** Exact resource URI from discovery, an expanded uriTemplate, or the user. */\\n  uri: string,\\n}): Promise<{\\n  server: string,\\n  uri: string,\\n  contents: Array<{\\n        type: \\\"text\\\",\\n        uri: string,\\n        text: string,\\n        mimeType?: string,\\n      } | {\\n        type: \\\"blob\\\",\\n        uri: string,\\n        blob: string,\\n        mimeType?: string,\\n      }>,\\n}>\"\n    },\n    {\n      \"path\": \"tools.opencode.list_mcp_resources\",\n      \"description\": \"List documents, records, and other data exposed by MCP servers. Use this when the user refers to something that is not a local file, such as a URI with a custom scheme, then load a match with read_mcp_resource. Each entry names the server to read it from. Templates are resources addressed by a parameter such as a record ID; fill in the uriTemplate placeholders before reading.\",\n      \"signature\": \"tools.opencode.list_mcp_resources({\\n  /** MCP server name as configured. Omit to list every server. */\\n  server?: string,\\n}): Promise<{\\n  resources: Array<{\\n      server: string,\\n      name: string,\\n      uri: string,\\n      description?: string,\\n      mimeType?: string,\\n    }>,\\n  templates: Array<{\\n      server: string,\\n      name: string,\\n      uriTemplate: string,\\n      description?: string,\\n      mimeType?: string,\\n    }>,\\n}>\"\n    }\n  ],\n  \"remaining\": 0,\n  \"next\": null\n}"}],"metadata":{"toolCalls":[{"tool":"search","status":"completed","input":{"query":"file"}}],"truncated":false},"executed":false},"durable":{"aggregateID":"ses_fake0002","seq":55,"version":2}}

