{
  "id": "agent",
  "name": "Agent",
  "version": "1.0.0",
  "description": "Chat with Claude Code over your notes in a pane beside the editor.",
  "enabledByDefault": true,
  "activation": ["onStartup"],
  "memory": {
    "level": "medium",
    "note": "Applies the saved pane state at startup (two subscriptions) and keeps the project list for the sidebar badge; the chat store and pane load when you first open the pane, and one Claude process starts per open chat. Nothing else runs while the pane is closed."
  },
  "rust": {
    "commands": [
      "agent_archive_project",
      "agent_auto_title",
      "agent_cancel",
      "agent_chat_action",
      "agent_chat_replay",
      "agent_close",
      "agent_create_project",
      "agent_detect_binary",
      "agent_import_chat_file",
      "agent_inspect_folder",
      "agent_list_chats",
      "agent_list_projects",
      "agent_list_skills",
      "agent_memory_delete",
      "agent_memory_forget_all",
      "agent_memory_import_claude",
      "agent_memory_list",
      "agent_load_chat",
      "agent_make_project",
      "agent_answer_question",
      "agent_permission",
      "agent_permission_rules",
      "agent_project_manifest",
      "agent_queue",
      "agent_read_project",
      "agent_regenerate_title",
      "agent_reload",
      "agent_remove_permission_rule",
      "agent_resume",
      "agent_revert_changes",
      "agent_save_chat",
      "agent_save_chat_file",
      "agent_session_changes",
      "agent_send",
      "agent_set_model",
      "agent_set_permission_mode",
      "agent_snapshot",
      "agent_start",
      "agent_steer",
      "agent_turn_changes",
      "agent_unqueue",
      "agent_update_project"
    ],
    "events": ["agent:event"],
    "hooks": ["start", "onWorkspaceClose", "onExit"],
    "cliCommands": ["project:archive", "project:unarchive"]
  },
  "contributes": {
    "commands": [
      {
        "id": "agent.toggle-pane",
        "label": "Agent: Toggle pane",
        "description": "Command",
        "when": "workspace-window"
      },
      {
        "id": "agent.new-chat",
        "label": "Agent: New chat",
        "description": "Command",
        "when": "workspace-window"
      },
      {
        "id": "agent.reload-session",
        "label": "Agent: Reload session",
        "description": "Command",
        "when": "workspace-window"
      },
      {
        "id": "agent.history",
        "label": "Agent: History",
        "description": "Command",
        "when": "workspace-window"
      },
      {
        "id": "agent.use-demo-backend",
        "label": "Agent: Use demo backend (recorded sessions)",
        "description": "Command",
        "when": "dev-workspace-window"
      },
      {
        "id": "agent.new-project",
        "label": "New project",
        "description": "Command",
        "when": "workspace-window"
      },
      {
        "id": "agent.projects",
        "label": "Agent: Projects",
        "description": "Command",
        "when": "workspace-window"
      },
      {
        "id": "agent.archive-project",
        "label": "Agent: Archive project",
        "description": "Command",
        "when": "workspace-window"
      },
      {
        "id": "agent.unarchive-project",
        "label": "Agent: Unarchive project...",
        "description": "Command",
        "when": "workspace-window"
      },
      {
        "id": "agent.make-project-from-folder",
        "label": "Make project from this folder",
        "description": "Command",
        "when": "workspace-window-in-folder"
      }
    ],
    "keybindings": [
      {
        "id": "agent.toggle-pane",
        "keys": ["Mod+Shift+A"],
        "description": "Show or hide the Agent pane",
        "layoutIndependent": true
      }
    ],
    "docks": ["agent.pane"],
    "sidebarActions": ["agent.toggle-action"],
    "overlays": ["agent.new-project-dialog", "agent.archive-project-dialog"],
    "menus": {
      "sidebar-folder": ["agent.make-project"]
    },
    "fileTreeDecorations": ["agent.project-badge"],
    "services": ["agent.context", "agent.chats"]
  },
  "provides": ["agent.context", "agent.chats"],
  "uses": ["git.history"]
}
