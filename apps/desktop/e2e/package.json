    "test:e2e": "pnpm run build:app && pnpm run test:wdio"
  },
  "devDependencies": {
    "@wdio/cli": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "webdriverio": "^9.27.0"
  }
}
